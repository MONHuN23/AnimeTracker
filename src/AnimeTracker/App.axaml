<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AnimeTracker.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Dark graphite and purple accent palette matching modern discovery reference -->
        <Color x:Key="AppBackground">#17171D</Color>
        <Color x:Key="AppSurface">#1D1D26</Color>
        <Color x:Key="AppSurfaceHover">#272733</Color>
        <Color x:Key="AppBorder">#34323F</Color>
        <Color x:Key="AppAccent">#8B5CF6</Color>
        <Color x:Key="AppAccentHover">#A78BFA</Color>
        <Color x:Key="AppTextPrimary">#F3F4F6</Color>
        <Color x:Key="AppTextSecondary">#9DA3AF</Color>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}" />
        <SolidColorBrush x:Key="AppSurfaceHoverBrush" Color="{StaticResource AppSurfaceHover}" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorder}" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccent}" />
        <SolidColorBrush x:Key="AppAccentHoverBrush" Color="{StaticResource AppAccentHover}" />
        <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="{StaticResource AppTextPrimary}" />
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="{StaticResource AppTextSecondary}" />
    </Application.Resources>
</Application>
