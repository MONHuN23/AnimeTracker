<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnimeTracker.ViewModels"
        xmlns:models="using:AnimeTracker.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AnimeTracker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AnimeTracker"
        Width="1100" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppTextPrimaryBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.media-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.card-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.discovery-tab">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.discovery-tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.discovery-tab.selected">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.discovery-tab.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Discovery Capsule Pills -->
        <Style Selector="Button.discovery-pill">
            <Setter Property="Background" Value="#22222E" />
            <Setter Property="Foreground" Value="#D1D5DB" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.discovery-pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C3C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.discovery-pill.active">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.discovery-pill.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- Search Bar Action Buttons -->
        <Style Selector="Button.search-icon-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.search-icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2C2C3C" />
        </Style>

        <Style Selector="Button.filter-purple-btn">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.filter-purple-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">
        <!-- Sidebar Navigation (Option B) -->
        <Border Grid.Column="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <!-- App Header -->
                <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AppAccentBrush}">
                            <TextBlock Text="AT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AnimeTracker"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Add Title Action Button -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="0,10"
                            Command="{Binding OpenAddTitleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Add Title" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LIBRARY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   Margin="8,8,8,6" />

                        <!-- Active View -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.CurrentlyActive}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Currently Active" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding ActiveCount}" FontSize="11" Foreground="{StaticResource AppAccentHoverBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- All Library -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.AllLibrary}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="All Library" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding TotalLibraryCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Plan to Watch/Read -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.PlanToWatchRead}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Plan to Watch / Read" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding PlanToCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Completed -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.Completed}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Completed" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding CompletedCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- On Hold / Dropped -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.OnHoldDropped}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="On Hold / Dropped" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding OnHoldDroppedCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" Margin="8,12" />

                        <TextBlock Text="DISCOVER &amp; SYSTEM"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   Margin="8,4,8,6" />

                        <!-- Recommendations / Discover -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.Recommendations}">
                            <TextBlock Text="Discover" VerticalAlignment="Center" />
                        </Button>

                        <!-- Settings & Backup -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.SettingsAndBackup}">
                            <TextBlock Text="Settings &amp; Backup" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Top Action / Filter Bar -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16"
                    IsVisible="{Binding !IsRecommendationsSection}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding CurrentSectionTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Track and manage your titles effortlessly"
                                   FontSize="12"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Filter & Sort Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsContentSection}">
                        <!-- Search Box -->
                        <TextBox Width="200"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search titles..."
                                 Background="{StaticResource AppSurfaceBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}"
                                 CornerRadius="6"
                                 FontSize="13" />

                        <!-- Media Type Filter -->
                        <ComboBox SelectedItem="{Binding SelectedMediaTypeFilter}"
                                  Background="{StaticResource AppSurfaceBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}"
                                  CornerRadius="6"
                                  FontSize="13"
                                  Width="120">
                            <vm:MediaTypeFilter>All</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Anime</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Manga</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Manhwa</vm:MediaTypeFilter>
                        </ComboBox>

                        <!-- Sort Order -->
                        <ComboBox SelectedItem="{Binding SelectedSortOrder}"
                                  Background="{StaticResource AppSurfaceBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}"
                                  CornerRadius="6"
                                  FontSize="13"
                                  Width="130">
                            <vm:MediaSortOrder>LastUpdated</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Title</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Score</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Progress</vm:MediaSortOrder>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (Cards Grid / Empty State / Non-content Section) -->
            <Grid Grid.Row="1" Margin="20">
                <!-- 1. Active Cards Grid View -->
                <ScrollViewer IsVisible="{Binding IsContentSection}" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Grid of Cards when items exist -->
                        <ItemsControl ItemsSource="{Binding FilteredItems}"
                                      IsVisible="{Binding !IsEmpty}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaCardViewModel">
                                    <Border Classes="media-card"
                                            Width="210"
                                            Margin="8"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Grid RowDefinitions="140,*">
                                            <!-- Poster Cover Area with Placeholder (Clickable to open details) -->
                                            <Button Grid.Row="0"
                                                    Classes="card-link"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch">
                                                <Grid Background="#181824" ClipToBounds="True">
                                                    <!-- Cover Image when loaded -->
                                                    <Image Source="{Binding CoverImage}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                    <!-- Fallback Placeholder when image is missing or loading -->
                                                    <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                            Background="#1e1e2c">
                                                        <TextBlock Text="★"
                                                                   FontSize="32"
                                                                   Foreground="#3b3b4f"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Type Badge (Top-Left) -->
                                                    <Border Background="#cc000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#cbd5e1" />
                                                    </Border>

                                                    <!-- Score Badge (Top-Right) -->
                                                    <Border IsVisible="{Binding ScoreDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="#cc000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#fbbf24" />
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <!-- Card Info and Stepper -->
                                            <StackPanel Grid.Row="1" Margin="12,10" Spacing="4">
                                                <Button Classes="card-link"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDetailCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               MaxLines="2"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                </Button>

                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AppTextSecondaryBrush}" />

                                                <!-- Inline + / - Progress Stepper -->
                                                <Border Background="{StaticResource AppBackgroundBrush}"
                                                        BorderBrush="{StaticResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="2"
                                                        Margin="0,6,0,0">
                                                    <Grid ColumnDefinitions="28,*,28">
                                                        <Button Grid.Column="0"
                                                                Content="−"
                                                                Command="{Binding DecrementProgressCommand}"
                                                                HorizontalContentAlignment="Center"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                Padding="0"
                                                                Height="26" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ProgressDisplay}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AppAccentHoverBrush}" />

                                                        <Button Grid.Column="2"
                                                                Content="+"
                                                                Command="{Binding IncrementProgressCommand}"
                                                                HorizontalContentAlignment="Center"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                Padding="0"
                                                                Height="26" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State message -->
                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsEmpty}"
                              Margin="0,60,0,0">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="400">
                                <Border Width="56" Height="56"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="📁"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="No titles found in this view"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" />

                                <TextBlock Text="Try clearing your search text, changing the status filter, or click '+ Add Title' on the left sidebar to add new titles."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- 2. Modern Discovery Experience Section -->
                <Grid IsVisible="{Binding IsRecommendationsSection}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="24,20,24,24">
                    <!-- 1. Discovery Page Header -->
                    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                        <TextBlock Text="Discover anime &amp; manga"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Find your next favorite title."
                                   FontSize="13"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 2. Integrated Search Bar with Filter Button -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <!-- Search Box Container -->
                        <Border Grid.Column="0"
                                Height="44"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="12,0"
                                Margin="0,0,10,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="🔍"
                                           FontSize="13"
                                           Foreground="{StaticResource AppTextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding CatalogSearchQuery, Mode=TwoWay}"
                                         PlaceholderText="Search anime, manga, manhwa..."
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="13"
                                         Foreground="{StaticResource AppTextPrimaryBrush}"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center" />

                                <Button Grid.Column="2"
                                        Classes="search-icon-btn"
                                        Command="{Binding ClearCatalogSearchCommand}"
                                        IsVisible="{Binding HasCatalogSearchQuery}"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Clear search">
                                    <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Purple Options / Genre Filter Button -->
                        <Button Grid.Column="1"
                                Classes="filter-purple-btn"
                                Height="44"
                                Width="44"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Filter genres &amp; options">
                            <TextBlock Text="🎛️" FontSize="16" Foreground="White" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16"
                                            MinWidth="240">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Filter by Genre"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                                            <ComboBox ItemsSource="{Binding TopFavoriteGenres}"
                                                      SelectedItem="{Binding SelectedRecommendationGenre, Mode=TwoWay}"
                                                      Background="{StaticResource AppBackgroundBrush}"
                                                      BorderBrush="{StaticResource AppBorderBrush}"
                                                      CornerRadius="6"
                                                      HorizontalAlignment="Stretch" />
                                            <Button Content="Refresh Recommendations"
                                                    Command="{Binding RefreshRecommendationsCommand}"
                                                    Background="{StaticResource AppAccentBrush}"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <!-- 3. Discovery Navigation Capsule Pills -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,20">
                        <Button Classes="discovery-pill"
                                Classes.active="{Binding IsForYouPillActive}"
                                Command="{Binding SelectDiscoveryPillCommand}"
                                CommandParameter="{x:Static vm:DiscoveryPill.ForYou}">
                            <TextBlock Text="For You" />
                        </Button>
                        <Button Classes="discovery-pill"
                                Classes.active="{Binding IsPopularPillActive}"
                                Command="{Binding SelectDiscoveryPillCommand}"
                                CommandParameter="{x:Static vm:DiscoveryPill.Popular}">
                            <TextBlock Text="Popular" />
                        </Button>
                        <Button Classes="discovery-pill"
                                Classes.active="{Binding IsAnimePillActive}"
                                Command="{Binding SelectDiscoveryPillCommand}"
                                CommandParameter="{x:Static vm:DiscoveryPill.Anime}">
                            <TextBlock Text="Anime" />
                        </Button>
                        <Button Classes="discovery-pill"
                                Classes.active="{Binding IsMangaPillActive}"
                                Command="{Binding SelectDiscoveryPillCommand}"
                                CommandParameter="{x:Static vm:DiscoveryPill.Manga}">
                            <TextBlock Text="Manga" />
                        </Button>
                        <Button Classes="discovery-pill"
                                Classes.active="{Binding IsManhwaPillActive}"
                                Command="{Binding SelectDiscoveryPillCommand}"
                                CommandParameter="{x:Static vm:DiscoveryPill.Manhwa}">
                            <TextBlock Text="Manhwa" />
                        </Button>
                    </StackPanel>

                    <!-- 4. Dynamic Section Header -->
                    <StackPanel Grid.Row="3" Spacing="2" Margin="0,0,0,16">
                        <TextBlock Text="{Binding DiscoverySectionTitle}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="{Binding DiscoverySectionSubtitle}"
                                   FontSize="13"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- 5. Success Message Banner -->
                    <Border Grid.Row="4"
                            Background="#1b2e23"
                            BorderBrush="#22c55e"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,14"
                            IsVisible="{Binding RecommendationSuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="✓" FontSize="14" FontWeight="Bold" Foreground="#22c55e" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding RecommendationSuccessMessage}" FontSize="12" Foreground="#86efac" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- 6. Scrollable Content Area (Dynamic Switcher) -->
                    <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <!-- A. Recommendations View (Active when !IsShowingSearchResults) -->
                            <Grid IsVisible="{Binding !IsShowingSearchResults}">
                                <!-- Loading State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsLoadingRecommendations}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="240"
                                                     Height="4"
                                                     Foreground="{StaticResource AppAccentBrush}"
                                                     Background="#262638" />
                                        <TextBlock Text="Discovering personalized recommendations..."
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Querying catalog and calculating taste match scores"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Error State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HasRecommendationError}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                        <Border Width="56" Height="56"
                                                Background="#2e171b"
                                                BorderBrush="#ef4444"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="⚠️"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="Unable to load recommendations"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />

                                        <TextBlock Text="{Binding RecommendationErrorMessage}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="#fca5a5" />

                                        <Button Content="Retry"
                                                Command="{Binding RefreshRecommendationsCommand}"
                                                Background="{StaticResource AppAccentBrush}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Padding="18,8"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Empty State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding ShowEmptyRecommendationState}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                        <Border Width="56" Height="56"
                                                Background="{StaticResource AppSurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="💡"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <TextBlock Text="No recommendations available"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />

                                        <TextBlock Text="{Binding RecommendationEmptyMessage}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Recommendations Poster Cards Grid -->
                                <ItemsControl ItemsSource="{Binding Recommendations}"
                                              IsVisible="{Binding HasRecommendations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecommendationCardViewModel">
                                            <Border Classes="media-card"
                                                    Width="215"
                                                    Margin="8"
                                                    Background="{StaticResource AppSurfaceBrush}"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    ClipToBounds="True">
                                                <Grid RowDefinitions="295,*">
                                                    <!-- Clickable Poster Area (2:3 Aspect Ratio) -->
                                                    <Button Grid.Row="0"
                                                            Classes="card-link"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecommendationDetailCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch">
                                                        <Grid Background="#181824" ClipToBounds="True">
                                                            <Image Source="{Binding CoverImage}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                                    Background="#1a1a26">
                                                                <TextBlock Text="★"
                                                                           FontSize="42"
                                                                           Foreground="#343248"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <!-- Type Badge (Top-Left) -->
                                                            <Border Background="#B3000000"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="8"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding TypeDisplay}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="White" />
                                                            </Border>
                                                            <!-- Rating Badge (Top-Right) -->
                                                            <Border Background="#CC000000"
                                                                    BorderBrush="#33FFFFFF"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="8"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding ScoreDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <TextBlock Text="{Binding ScoreDisplay}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="#FBBF24" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Card Info, Reason, and Action -->
                                                    <Grid Grid.Row="1" Margin="12,10" RowDefinitions="Auto,Auto,Auto,*">
                                                        <Button Grid.Row="0"
                                                                Classes="card-link"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecommendationDetailCommand}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Left"
                                                                HorizontalContentAlignment="Left">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       MaxLines="2"
                                                                       TextWrapping="Wrap"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                        </Button>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding ReasonDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0" />

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding ProgressDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AppAccentHoverBrush}"
                                                                   Margin="0,4,0,8" />

                                                        <!-- Action Button -->
                                                        <Panel Grid.Row="3">
                                                            <Border Background="#1b2e23"
                                                                    BorderBrush="#22c55e"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,6"
                                                                    HorizontalAlignment="Stretch"
                                                                    IsVisible="{Binding IsInLibrary}">
                                                                <TextBlock Text="✓ In Library"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#86efac"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>

                                                            <Button Content="+ Add to Library"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddRecommendationToLibraryCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{StaticResource AppAccentBrush}"
                                                                    Foreground="White"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Padding="10,6"
                                                                    CornerRadius="6"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    IsVisible="{Binding !IsInLibrary}" />
                                                        </Panel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- B. Catalog Search Results View (Active when IsShowingSearchResults) -->
                            <Grid IsVisible="{Binding IsShowingSearchResults}">
                                <!-- Loading State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding IsLoadingCatalogSearch}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="240"
                                                     Height="4"
                                                     Foreground="{StaticResource AppAccentBrush}"
                                                     Background="#262638" />
                                        <TextBlock Text="Searching Jikan catalog..."
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Error State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HasCatalogSearchError}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                        <Border Width="56" Height="56"
                                                Background="#2e171b"
                                                BorderBrush="#ef4444"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="⚠️"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Catalog search failed"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CatalogSearchErrorMessage}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="#fca5a5" />
                                        <Button Content="Retry"
                                                Command="{Binding SearchCatalogNowCommand}"
                                                Background="{StaticResource AppAccentBrush}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                Padding="18,8"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Empty Search State -->
                                <Grid HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding ShowEmptyCatalogSearchState}"
                                      Margin="0,60,0,0">
                                    <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                        <Border Width="56" Height="56"
                                                Background="{StaticResource AppSurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                HorizontalAlignment="Center">
                                            <TextBlock Text="🔍"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="No results found"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="{Binding CatalogSearchEmptyMessage}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                                        <Button Content="Clear Search"
                                                Command="{Binding ClearCatalogSearchCommand}"
                                                Background="{StaticResource AppSurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                Foreground="{StaticResource AppTextPrimaryBrush}"
                                                Padding="16,8"
                                                CornerRadius="6"
                                                HorizontalAlignment="Center"
                                                Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <!-- Catalog Search Results Poster Cards Grid -->
                                <ItemsControl ItemsSource="{Binding CatalogSearchResults}"
                                              IsVisible="{Binding HasCatalogSearchResults}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CatalogSearchCardViewModel">
                                            <Border Classes="media-card"
                                                    Width="215"
                                                    Margin="8"
                                                    Background="{StaticResource AppSurfaceBrush}"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    ClipToBounds="True">
                                                <Grid RowDefinitions="295,*">
                                                    <!-- Poster Area (2:3 Aspect Ratio) -->
                                                    <Grid Grid.Row="0" Background="#181824" ClipToBounds="True">
                                                        <Image Source="{Binding CoverImage}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                                Background="#1a1a26">
                                                            <TextBlock Text="🎬"
                                                                       FontSize="38"
                                                                       Foreground="#343248"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- Type Badge (Top-Left) -->
                                                        <Border Background="#B3000000"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TypeDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </Border>
                                                        <!-- Score Badge (Top-Right) -->
                                                        <Border Background="#CC000000"
                                                                BorderBrush="#33FFFFFF"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="8"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top"
                                                                IsVisible="{Binding ScoreDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                            <TextBlock Text="{Binding ScoreDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#FBBF24" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Card Info and Action -->
                                                    <Grid Grid.Row="1" Margin="12,10" RowDefinitions="Auto,Auto,Auto,*">
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding ReasonDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,4,0,0" />

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding ProgressDisplay}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AppAccentHoverBrush}"
                                                                   Margin="0,4,0,8" />

                                                        <!-- Action Button / Library Badge -->
                                                        <Panel Grid.Row="3">
                                                            <!-- Already in library badge -->
                                                            <Border Background="#1b2e23"
                                                                    BorderBrush="#22c55e"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Padding="8,6"
                                                                    HorizontalAlignment="Stretch"
                                                                    IsVisible="{Binding IsInLibrary}">
                                                                <TextBlock Text="✓ In Library"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#86efac"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>

                                                            <!-- Add to Library Button -->
                                                            <Button Content="+ Add to Library"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddCatalogSearchResultToLibraryCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="{StaticResource AppAccentBrush}"
                                                                    Foreground="White"
                                                                    FontWeight="SemiBold"
                                                                    FontSize="12"
                                                                    Padding="10,6"
                                                                    CornerRadius="6"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Center"
                                                                    IsVisible="{Binding !IsInLibrary}" />
                                                        </Panel>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Panel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. Settings & Backup Section -->
                <ScrollViewer IsVisible="{Binding IsSettingsAndBackupSection}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Margin="32,24,32,40" MaxWidth="720" HorizontalAlignment="Left">
                        <!-- Header -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Settings &amp; Backup"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Export your collection to a standalone JSON file, or restore/replace your library from a backup."
                                       FontSize="13"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Status Message Banner (Success) -->
                        <Border Background="#1b2e23"
                                BorderBrush="#22c55e"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding BackupStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="✓" FontSize="16" FontWeight="Bold" Foreground="#22c55e" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BackupStatusMessage}" FontSize="13" Foreground="#86efac" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Error Message Banner -->
                        <Border Background="#2e171b"
                                BorderBrush="#ef4444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding BackupErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="⚠" FontSize="16" FontWeight="Bold" Foreground="#ef4444" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BackupErrorMessage}" FontSize="13" Foreground="#fca5a5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 1: Export -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                    <TextBlock Text="Export Library"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Create a complete JSON export of all your tracked anime, manga, and manhwa items including your current progress, status, personal scores, and rewatch counters."
                                               FontSize="12"
                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Command="{Binding RequestExportCommand}"
                                        Background="{StaticResource AppAccentBrush}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="16,10"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⤓" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="Export JSON" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Import & Restore -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                        <TextBlock Text="Import &amp; Restore Library"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Restore your collection from a previous AnimeTracker backup file. The backup format is validated for correct version, schema integrity, and duplicate prevention before any modification occurs."
                                                   FontSize="12"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding RequestImportCommand}"
                                            Background="#2a2a3e"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource AppTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Padding="16,10"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⤒" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="Select File..." FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Confirmation Panel (Visible when file is validated and pending confirmation) -->
                                <Border Background="#2b1a1a"
                                        BorderBrush="#ef4444"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        IsVisible="{Binding IsImportConfirming}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Warning: Replacing Existing Library"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#f87171"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding ValidatedImportCount, StringFormat='A backup with {0} items has been validated. Confirming will completely replace your current local database with the contents of this file. This operation is transactional and atomic.'}"
                                                   FontSize="12"
                                                   Foreground="#fca5a5"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelImportCommand}"
                                                    Background="#1e1e2d"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{StaticResource AppTextPrimaryBrush}"
                                                    Padding="14,8"
                                                    CornerRadius="6" />

                                            <Button Content="Yes, Replace Library"
                                                    Command="{Binding ConfirmImportCommand}"
                                                    Background="#dc2626"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Padding="14,8"
                                                    CornerRadius="6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: About AnimeTracker -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="About AnimeTracker"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" />

                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 10 LTS + Avalonia UI 12.x (MVVM)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Local SQLite with Dapper micro-ORM (library.db)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="External API:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Jikan API v4 (REST)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Version:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="1.0.0 (MVP Complete)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
