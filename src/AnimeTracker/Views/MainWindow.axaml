<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnimeTracker.ViewModels"
        xmlns:models="using:AnimeTracker.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="AnimeTracker.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AnimeTracker"
        Width="1100" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppTextPrimaryBrush}">

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style Selector="Border.media-card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.card-link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.card-link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.discovery-tab">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.discovery-tab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppSurfaceHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.discovery-tab.selected">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
        </Style>
        <Style Selector="Button.discovery-tab.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="260,*">
        <!-- Sidebar Navigation (Option B) -->
        <Border Grid.Column="0"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppBorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <DockPanel LastChildFill="True">
                <!-- App Header -->
                <StackPanel DockPanel.Dock="Top" Spacing="16" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource AppAccentBrush}">
                            <TextBlock Text="AT"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AnimeTracker"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Add Title Action Button -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="{StaticResource AppAccentBrush}"
                            Foreground="White"
                            FontWeight="SemiBold"
                            CornerRadius="8"
                            Padding="0,10"
                            Command="{Binding OpenAddTitleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+" FontSize="14" FontWeight="Bold" />
                            <TextBlock Text="Add Title" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Navigation List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="LIBRARY"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   Margin="8,8,8,6" />

                        <!-- Active View -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.CurrentlyActive}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Currently Active" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding ActiveCount}" FontSize="11" Foreground="{StaticResource AppAccentHoverBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- All Library -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.AllLibrary}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="All Library" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding TotalLibraryCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Plan to Watch/Read -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.PlanToWatchRead}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Plan to Watch / Read" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding PlanToCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Completed -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.Completed}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Completed" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding CompletedCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- On Hold / Dropped -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.OnHoldDropped}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="On Hold / Dropped" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Classes="badge">
                                    <TextBlock Text="{Binding OnHoldDroppedCount}" FontSize="11" Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Divider -->
                        <Rectangle Height="1" Fill="{StaticResource AppBorderBrush}" Margin="8,12" />

                        <TextBlock Text="DISCOVER &amp; SYSTEM"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   Margin="8,4,8,6" />

                        <!-- Recommendations -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.Recommendations}">
                            <TextBlock Text="Recommendations" VerticalAlignment="Center" />
                        </Button>

                        <!-- Settings & Backup -->
                        <Button Classes="nav" Command="{Binding SelectSectionCommand}" CommandParameter="{x:Static vm:NavigationSection.SettingsAndBackup}">
                            <TextBlock Text="Settings &amp; Backup" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <!-- Top Action / Filter Bar -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{Binding CurrentSectionTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                        <TextBlock Text="Track and manage your titles effortlessly"
                                   FontSize="12"
                                   Foreground="{StaticResource AppTextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Filter & Sort Controls -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsContentSection}">
                        <!-- Search Box -->
                        <TextBox Width="200"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="Search titles..."
                                 Background="{StaticResource AppSurfaceBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}"
                                 CornerRadius="6"
                                 FontSize="13" />

                        <!-- Media Type Filter -->
                        <ComboBox SelectedItem="{Binding SelectedMediaTypeFilter}"
                                  Background="{StaticResource AppSurfaceBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}"
                                  CornerRadius="6"
                                  FontSize="13"
                                  Width="120">
                            <vm:MediaTypeFilter>All</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Anime</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Manga</vm:MediaTypeFilter>
                            <vm:MediaTypeFilter>Manhwa</vm:MediaTypeFilter>
                        </ComboBox>

                        <!-- Sort Order -->
                        <ComboBox SelectedItem="{Binding SelectedSortOrder}"
                                  Background="{StaticResource AppSurfaceBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}"
                                  CornerRadius="6"
                                  FontSize="13"
                                  Width="130">
                            <vm:MediaSortOrder>LastUpdated</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Title</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Score</vm:MediaSortOrder>
                            <vm:MediaSortOrder>Progress</vm:MediaSortOrder>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Area (Cards Grid / Empty State / Non-content Section) -->
            <Grid Grid.Row="1" Margin="20">
                <!-- 1. Active Cards Grid View -->
                <ScrollViewer IsVisible="{Binding IsContentSection}" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Grid of Cards when items exist -->
                        <ItemsControl ItemsSource="{Binding FilteredItems}"
                                      IsVisible="{Binding !IsEmpty}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MediaCardViewModel">
                                    <Border Classes="media-card"
                                            Width="210"
                                            Margin="8"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            ClipToBounds="True">
                                        <Grid RowDefinitions="140,*">
                                            <!-- Poster Cover Area with Placeholder (Clickable to open details) -->
                                            <Button Grid.Row="0"
                                                    Classes="card-link"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDetailCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    VerticalContentAlignment="Stretch">
                                                <Grid Background="#181824" ClipToBounds="True">
                                                    <!-- Cover Image when loaded -->
                                                    <Image Source="{Binding CoverImage}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                    <!-- Fallback Placeholder when image is missing or loading -->
                                                    <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                            Background="#1e1e2c">
                                                        <TextBlock Text="★"
                                                                   FontSize="32"
                                                                   Foreground="#3b3b4f"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Type Badge (Top-Left) -->
                                                    <Border Background="#cc000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#cbd5e1" />
                                                    </Border>

                                                    <!-- Score Badge (Top-Right) -->
                                                    <Border IsVisible="{Binding ScoreDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                            Background="#cc000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#fbbf24" />
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <!-- Card Info and Stepper -->
                                            <StackPanel Grid.Row="1" Margin="12,10" Spacing="4">
                                                <Button Classes="card-link"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenDetailCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               MaxLines="2"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                </Button>

                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AppTextSecondaryBrush}" />

                                                <!-- Inline + / - Progress Stepper -->
                                                <Border Background="{StaticResource AppBackgroundBrush}"
                                                        BorderBrush="{StaticResource AppBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="2"
                                                        Margin="0,6,0,0">
                                                    <Grid ColumnDefinitions="28,*,28">
                                                        <Button Grid.Column="0"
                                                                Content="−"
                                                                Command="{Binding DecrementProgressCommand}"
                                                                HorizontalContentAlignment="Center"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                Padding="0"
                                                                Height="26" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ProgressDisplay}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource AppAccentHoverBrush}" />

                                                        <Button Grid.Column="2"
                                                                Content="+"
                                                                Command="{Binding IncrementProgressCommand}"
                                                                HorizontalContentAlignment="Center"
                                                                Background="Transparent"
                                                                Foreground="{StaticResource AppTextSecondaryBrush}"
                                                                Padding="0"
                                                                Height="26" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State message -->
                        <Grid HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="{Binding IsEmpty}"
                              Margin="0,60,0,0">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="400">
                                <Border Width="56" Height="56"
                                        Background="{StaticResource AppSurfaceBrush}"
                                        BorderBrush="{StaticResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="📁"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="No titles found in this view"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" />

                                <TextBlock Text="Try clearing your search text, changing the status filter, or click '+ Add Title' on the left sidebar to add new titles."
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           Foreground="{StaticResource AppTextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- 2. Recommendations & Discovery Section -->
                <Grid IsVisible="{Binding IsRecommendationsSection}" RowDefinitions="Auto,Auto,*" Margin="24">
                    <!-- Top Discovery Mode Selector Tabs -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Classes="discovery-tab"
                                    Classes.selected="{Binding IsDiscoveryRecommendationsTab}"
                                    Command="{Binding SelectDiscoveryTabCommand}"
                                    CommandParameter="{x:Static vm:DiscoveryTab.Recommendations}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="★" Foreground="#fbbf24" VerticalAlignment="Center" />
                                    <TextBlock Text="Recommendations For You" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Classes="discovery-tab"
                                    Classes.selected="{Binding IsDiscoverySearchTab}"
                                    Command="{Binding SelectDiscoveryTabCommand}"
                                    CommandParameter="{x:Static vm:DiscoveryTab.Search}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🔍" VerticalAlignment="Center" />
                                    <TextBlock Text="Search Catalog" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Success Message Banner -->
                    <Border Grid.Row="1"
                            Background="#1b2e23"
                            BorderBrush="#22c55e"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,14"
                            IsVisible="{Binding RecommendationSuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="✓" FontSize="14" FontWeight="Bold" Foreground="#22c55e" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding RecommendationSuccessMessage}" FontSize="12" Foreground="#86efac" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Row 2: Sub-views -->
                    <Grid Grid.Row="2">
                        <!-- SUB-VIEW 1: PERSONALIZED RECOMMENDATIONS -->
                        <Grid IsVisible="{Binding IsDiscoveryRecommendationsTab}" RowDefinitions="Auto,*">
                            <!-- Recommendations Filter Toolbar -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,16">
                        <!-- Media Type Filter -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Type:"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <ComboBox SelectedItem="{Binding SelectedMediaTypeFilter}"
                                      Background="{StaticResource AppSurfaceBrush}"
                                      BorderBrush="{StaticResource AppBorderBrush}"
                                      CornerRadius="6"
                                      Width="120">
                                <vm:MediaTypeFilter>All</vm:MediaTypeFilter>
                                <vm:MediaTypeFilter>Anime</vm:MediaTypeFilter>
                                <vm:MediaTypeFilter>Manga</vm:MediaTypeFilter>
                                <vm:MediaTypeFilter>Manhwa</vm:MediaTypeFilter>
                            </ComboBox>
                        </StackPanel>

                        <!-- Genre Filter -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Genre:"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <ComboBox ItemsSource="{Binding TopFavoriteGenres}"
                                      SelectedItem="{Binding SelectedRecommendationGenre, Mode=TwoWay}"
                                      Background="{StaticResource AppSurfaceBrush}"
                                      BorderBrush="{StaticResource AppBorderBrush}"
                                      CornerRadius="6"
                                      Width="160" />
                        </StackPanel>

                        <!-- Refresh Button -->
                        <Button Grid.Column="2"
                                Command="{Binding RefreshRecommendationsCommand}"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource AppTextPrimaryBrush}"
                                CornerRadius="6"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↻" FontSize="13" FontWeight="Bold" />
                                <TextBlock Text="Refresh" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="4"
                                   Text="Personalized recommendations discovered from Jikan based on your 8/10+ rated titles"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- Recommendations List / Cards Area -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- 1. Loading State -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsLoadingRecommendations}"
                                  Margin="0,80,0,0">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="240"
                                                 Height="4"
                                                 Foreground="{StaticResource AppAccentBrush}"
                                                 Background="#262638" />
                                    <TextBlock Text="Discovering personalized recommendations..."
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Querying catalog and calculating taste match scores"
                                               FontSize="12"
                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 2. Error State -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasRecommendationError}"
                                  Margin="0,60,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                    <Border Width="56" Height="56"
                                            Background="#2e171b"
                                            BorderBrush="#ef4444"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="⚠️"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="Unable to load recommendations"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding RecommendationErrorMessage}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="#fca5a5" />

                                    <Button Content="Retry"
                                            Command="{Binding RefreshRecommendationsCommand}"
                                            Background="{StaticResource AppAccentBrush}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="18,8"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 3. Empty State message -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowEmptyRecommendationState}"
                                  Margin="0,60,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                    <Border Width="56" Height="56"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="💡"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="No recommendations available"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />

                                    <TextBlock Text="{Binding RecommendationEmptyMessage}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 4. Recommendations Card Grid -->
                            <ItemsControl ItemsSource="{Binding Recommendations}"
                                          IsVisible="{Binding HasRecommendations}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecommendationCardViewModel">
                                        <Border Classes="media-card"
                                                Width="230"
                                                Margin="8"
                                                Background="{StaticResource AppSurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                ClipToBounds="True">
                                            <Grid RowDefinitions="150,*">
                                                <!-- Clickable Poster Area -->
                                                <Button Grid.Row="0"
                                                        Classes="card-link"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecommendationDetailCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch">
                                                    <Grid Background="#181824" ClipToBounds="True">
                                                        <Image Source="{Binding CoverImage}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                        <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                                Background="#1e1e2c">
                                                            <TextBlock Text="★"
                                                                       FontSize="36"
                                                                       Foreground="#3b3b4f"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <!-- Type Badge (Top-Left) -->
                                                        <Border Background="#cc000000"
                                                                CornerRadius="4"
                                                                Padding="5,2"
                                                                Margin="6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding TypeDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="#cbd5e1" />
                                                        </Border>
                                                        <!-- Match Score Badge (Top-Right) -->
                                                        <Border Background="#cc8b5cf6"
                                                                CornerRadius="4"
                                                                Padding="6,2"
                                                                Margin="6"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding MatchScoreDisplay}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Button>

                                                <!-- Card Info, Factual Reason, and Action -->
                                                <StackPanel Grid.Row="1" Margin="12,10" Spacing="6">
                                                    <Button Classes="card-link"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenRecommendationDetailCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Left"
                                                            HorizontalContentAlignment="Left">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                                    </Button>

                                                    <!-- Factual Reason Badge -->
                                                    <Border Background="{StaticResource AppBackgroundBrush}"
                                                            BorderBrush="{StaticResource AppBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,6">
                                                        <TextBlock Text="{Binding Reason}"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource AppAccentHoverBrush}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>

                                                    <TextBlock Text="{Binding ProgressDisplay}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AppTextSecondaryBrush}" />

                                                    <!-- Direct Add to Library Button -->
                                                    <Button Content="+ Add to Library"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddRecommendationToLibraryCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{StaticResource AppAccentBrush}"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            Padding="10,6"
                                                            CornerRadius="6"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- SUB-VIEW 2: SEARCH CATALOG -->
                <Grid IsVisible="{Binding IsDiscoverySearchTab}" RowDefinitions="Auto,*">
                    <!-- Search Input & Type Filter Toolbar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                        <ComboBox Grid.Column="0"
                                  SelectedItem="{Binding CatalogSearchMediaType}"
                                  Background="{StaticResource AppSurfaceBrush}"
                                  BorderBrush="{StaticResource AppBorderBrush}"
                                  CornerRadius="6"
                                  Width="120"
                                  Margin="0,0,12,0">
                            <models:MediaType>Anime</models:MediaType>
                            <models:MediaType>Manga</models:MediaType>
                            <models:MediaType>Manhwa</models:MediaType>
                        </ComboBox>

                        <TextBox Grid.Column="1"
                                 Text="{Binding CatalogSearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search anime, manga, or manhwa by title (e.g. One Piece, Solo Leveling)..."
                                 Background="{StaticResource AppSurfaceBrush}"
                                 BorderBrush="{StaticResource AppBorderBrush}"
                                 CornerRadius="6"
                                 FontSize="13" />

                        <Button Grid.Column="2"
                                Content="Search"
                                Command="{Binding SearchCatalogNowCommand}"
                                Background="{StaticResource AppAccentBrush}"
                                Foreground="White"
                                FontWeight="SemiBold"
                                CornerRadius="6"
                                Padding="16,8"
                                Margin="10,0,0,0"
                                VerticalAlignment="Stretch" />
                    </Grid>

                    <!-- Results and Status ScrollViewer -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- 1. Loading State -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsLoadingCatalogSearch}"
                                  Margin="0,80,0,0">
                                <StackPanel Spacing="14" HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="240"
                                                 Height="4"
                                                 Foreground="{StaticResource AppAccentBrush}"
                                                 Background="#262638" />
                                    <TextBlock Text="Searching Jikan catalog..."
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextPrimaryBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- 2. Error State -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding HasCatalogSearchError}"
                                  Margin="0,60,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                    <Border Width="56" Height="56"
                                            Background="#2e171b"
                                            BorderBrush="#ef4444"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="⚠️"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Catalog search failed"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CatalogSearchErrorMessage}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="#fca5a5" />
                                    <Button Content="Retry"
                                            Command="{Binding SearchCatalogNowCommand}"
                                            Background="{StaticResource AppAccentBrush}"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            Padding="18,8"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            Margin="0,8,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 3. Empty Search State -->
                            <Grid HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding ShowEmptyCatalogSearchState}"
                                  Margin="0,60,0,0">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="440">
                                    <Border Width="56" Height="56"
                                            Background="{StaticResource AppSurfaceBrush}"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="🔍"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No results found"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CatalogSearchEmptyMessage}"
                                               FontSize="13"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- 4. Catalog Search Results Grid -->
                            <ItemsControl ItemsSource="{Binding CatalogSearchResults}"
                                          IsVisible="{Binding HasCatalogSearchResults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CatalogSearchCardViewModel">
                                        <Border Classes="media-card"
                                                Width="230"
                                                Margin="8"
                                                Background="{StaticResource AppSurfaceBrush}"
                                                BorderBrush="{StaticResource AppBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                ClipToBounds="True">
                                            <Grid RowDefinitions="150,*">
                                                <!-- Poster Area -->
                                                <Grid Grid.Row="0" Background="#181824" ClipToBounds="True">
                                                    <Image Source="{Binding CoverImage}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                                            Background="#1e1e2c">
                                                        <TextBlock Text="🎬"
                                                                   FontSize="32"
                                                                   Foreground="#3b3b4f"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <!-- Type Badge (Top-Left) -->
                                                    <Border Background="#cc000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Top">
                                                        <TextBlock Text="{Binding TypeDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#cbd5e1" />
                                                    </Border>
                                                    <!-- Score Badge (Top-Right) -->
                                                    <Border Background="#ccf59e0b"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="6"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            IsVisible="{Binding ScoreDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="Black" />
                                                    </Border>
                                                </Grid>

                                                <!-- Card Info and Action -->
                                                <Grid Grid.Row="1" Margin="12,10" RowDefinitions="Auto,Auto,Auto,Auto,*">
                                                    <TextBlock Grid.Row="0"
                                                               Text="{Binding Title}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               MaxLines="2"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource AppTextPrimaryBrush}" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding EnglishTitle}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding EnglishTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               Margin="0,2,0,0" />

                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding ProgressDisplay}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                                               Margin="0,4,0,0" />

                                                    <TextBlock Grid.Row="3"
                                                               Text="{Binding GenresDisplay}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource AppAccentHoverBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding GenresDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                               Margin="0,2,0,4" />

                                                    <!-- Action Button / Library Badge -->
                                                    <Panel Grid.Row="4" Margin="0,4,0,0">
                                                        <!-- Already in library badge -->
                                                        <Border Background="#1b2e23"
                                                                BorderBrush="#22c55e"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="8,6"
                                                                HorizontalAlignment="Stretch"
                                                                IsVisible="{Binding IsInLibrary}">
                                                            <TextBlock Text="✓ In Library"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#86efac"
                                                                       HorizontalAlignment="Center" />
                                                        </Border>

                                                        <!-- Add to Library Button -->
                                                        <Button Content="+ Add to Library"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddCatalogSearchResultToLibraryCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{StaticResource AppAccentBrush}"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                FontSize="12"
                                                                Padding="10,6"
                                                                CornerRadius="6"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                IsVisible="{Binding !IsInLibrary}" />
                                                    </Panel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

                <!-- 3. Settings & Backup Section -->
                <ScrollViewer IsVisible="{Binding IsSettingsAndBackupSection}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Margin="32,24,32,40" MaxWidth="720" HorizontalAlignment="Left">
                        <!-- Header -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Settings &amp; Backup"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AppTextPrimaryBrush}" />
                            <TextBlock Text="Export your collection to a standalone JSON file, or restore/replace your library from a backup."
                                       FontSize="13"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>

                        <!-- Status Message Banner (Success) -->
                        <Border Background="#1b2e23"
                                BorderBrush="#22c55e"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding BackupStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="✓" FontSize="16" FontWeight="Bold" Foreground="#22c55e" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BackupStatusMessage}" FontSize="13" Foreground="#86efac" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Error Message Banner -->
                        <Border Background="#2e171b"
                                BorderBrush="#ef4444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding BackupErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="⚠" FontSize="16" FontWeight="Bold" Foreground="#ef4444" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BackupErrorMessage}" FontSize="13" Foreground="#fca5a5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Card 1: Export -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                    <TextBlock Text="Export Library"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="Create a complete JSON export of all your tracked anime, manga, and manhwa items including your current progress, status, personal scores, and rewatch counters."
                                               FontSize="12"
                                               Foreground="{StaticResource AppTextSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1"
                                        Command="{Binding RequestExportCommand}"
                                        Background="{StaticResource AppAccentBrush}"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="16,10"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="⤓" FontSize="15" FontWeight="Bold" />
                                        <TextBlock Text="Export JSON" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Card 2: Import & Restore -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,24,0">
                                        <TextBlock Text="Import &amp; Restore Library"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AppTextPrimaryBrush}" />
                                        <TextBlock Text="Restore your collection from a previous AnimeTracker backup file. The backup format is validated for correct version, schema integrity, and duplicate prevention before any modification occurs."
                                                   FontSize="12"
                                                   Foreground="{StaticResource AppTextSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Command="{Binding RequestImportCommand}"
                                            Background="#2a2a3e"
                                            BorderBrush="{StaticResource AppBorderBrush}"
                                            BorderThickness="1"
                                            Foreground="{StaticResource AppTextPrimaryBrush}"
                                            FontWeight="SemiBold"
                                            Padding="16,10"
                                            CornerRadius="8"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⤒" FontSize="15" FontWeight="Bold" />
                                            <TextBlock Text="Select File..." FontSize="13" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Confirmation Panel (Visible when file is validated and pending confirmation) -->
                                <Border Background="#2b1a1a"
                                        BorderBrush="#ef4444"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        IsVisible="{Binding IsImportConfirming}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚠️" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Warning: Replacing Existing Library"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="#f87171"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding ValidatedImportCount, StringFormat='A backup with {0} items has been validated. Confirming will completely replace your current local database with the contents of this file. This operation is transactional and atomic.'}"
                                                   FontSize="12"
                                                   Foreground="#fca5a5"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <Button Content="Cancel"
                                                    Command="{Binding CancelImportCommand}"
                                                    Background="#1e1e2d"
                                                    BorderBrush="{StaticResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{StaticResource AppTextPrimaryBrush}"
                                                    Padding="14,8"
                                                    CornerRadius="6" />

                                            <Button Content="Yes, Replace Library"
                                                    Command="{Binding ConfirmImportCommand}"
                                                    Background="#dc2626"
                                                    Foreground="White"
                                                    FontWeight="SemiBold"
                                                    Padding="14,8"
                                                    CornerRadius="6" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: About AnimeTracker -->
                        <Border Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock Text="About AnimeTracker"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" />

                                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Platform:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 10 LTS + Avalonia UI 12.x (MVVM)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Database:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Local SQLite with Dapper micro-ORM (library.db)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="External API:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="Jikan API v4 (REST)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Version:" FontSize="12" Foreground="{StaticResource AppTextSecondaryBrush}" Margin="0,3" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="1.0.0 (MVP Complete)" FontSize="12" Foreground="{StaticResource AppTextPrimaryBrush}" Margin="0,3" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
