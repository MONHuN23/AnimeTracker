<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AnimeTracker.ViewModels"
        xmlns:models="using:AnimeTracker.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
        x:Class="AnimeTracker.Views.MediaDetailWindow"
        x:DataType="vm:MediaDetailViewModel"
        Title="{Binding Title, StringFormat='{}{0} - Details &amp; Edit'}"
        Width="820" Height="660"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource AppTextPrimaryBrush}">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AppTextPrimaryBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="20"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="550" />
                    <!-- Type Badge -->
                    <Border Background="{StaticResource AppAccentBrush}"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TypeDisplay}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                </StackPanel>

                <!-- Subtitle with external metadata -->
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding MalId, StringFormat='MAL ID: #{0}'}"
                               IsVisible="{Binding MalId, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="12"
                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                    <TextBlock Text="{Binding ReleaseYear, StringFormat='Year: {0}'}"
                               IsVisible="{Binding ReleaseYear, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="12"
                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="✕"
                    Command="{Binding CancelCommand}"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="16"
                    Foreground="{StaticResource AppTextSecondaryBrush}"
                    VerticalAlignment="Top" />
        </Grid>

        <!-- Main Content Area: Left Poster & Quick Actions / Right Editable Form -->
        <Grid Grid.Row="1" ColumnDefinitions="240,*" Margin="0,0,0,16">
            <!-- Left Side: Poster and Tracking Actions -->
            <Border Grid.Column="0"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,16,0">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <!-- Poster Image -->
                        <Border Height="280"
                                Background="#181824"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding CoverImage}"
                                       Stretch="UniformToFill"
                                       IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Border IsVisible="{Binding CoverImage, Converter={x:Static ObjectConverters.IsNull}}"
                                        Background="#1e1e2c">
                                    <TextBlock Text="★"
                                               FontSize="48"
                                               Foreground="#3b3b4f"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Cover Image Actions -->
                        <StackPanel Spacing="6">
                            <Button Content="Choose Cover..."
                                    Command="{Binding ChooseCoverImageCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource AppSurfaceHoverBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    FontSize="12" />
                            <Button Content="Remove Custom Cover"
                                    Command="{Binding RemoveCustomCoverCommand}"
                                    IsVisible="{Binding HasCustomCover}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="#ef4444"
                                    Foreground="#f87171"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    FontSize="12" />
                        </StackPanel>

                        <!-- Progress Display with Steppers -->
                        <Border Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="CURRENT PROGRESS"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AppTextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ProgressDisplay}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AppAccentHoverBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="−"
                                            Command="{Binding DecrementProgressCommand}"
                                            Width="28" Height="28"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="4" />
                                    <Button Content="+"
                                            Command="{Binding IncrementProgressCommand}"
                                            Width="28" Height="28"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            CornerRadius="4" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Rewatch / Reread Count -->
                        <Border Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="REWATCH / REREAD COUNT"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextSecondaryBrush}" />
                                <TextBlock Text="{Binding RewatchCount, StringFormat='{}{0} times'}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Tracking Actions -->
                        <StackPanel Spacing="8">
                            <Button Content="Mark Completed"
                                    Command="{Binding MarkCompletedCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource AppSurfaceHoverBrush}"
                                    BorderBrush="{StaticResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Foreground="{StaticResource AppTextPrimaryBrush}"
                                    CornerRadius="6"
                                    Padding="10,8" />

                            <Button Content="{Binding RewatchActionLabel}"
                                    Command="{Binding StartRewatchCommand}"
                                    IsEnabled="{Binding CanRewatch}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Background="{StaticResource AppAccentBrush}"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    CornerRadius="6"
                                    Padding="10,8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Side: Editable Details Form -->
            <Border Grid.Column="1"
                    Background="{StaticResource AppSurfaceBrush}"
                    BorderBrush="{StaticResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <ScrollViewer>
                    <StackPanel Spacing="14">
                        <!-- Validation Error Banner -->
                        <Border IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="#3a1c1c"
                                BorderBrush="#ef4444"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,8">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#fca5a5"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Title -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Title *" FontWeight="SemiBold" FontSize="13" />
                            <TextBox Text="{Binding Title, Mode=TwoWay}"
                                     PlaceholderText="Enter title..." />
                        </StackPanel>

                        <!-- Status & Score Row -->
                        <Grid ColumnDefinitions="*,*">
                            <!-- Status -->
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
                                <TextBlock Text="Status *" FontWeight="SemiBold" FontSize="13" />
                                <ComboBox ItemsSource="{Binding AvailableStatuses}"
                                          SelectedItem="{Binding Status, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <!-- Score -->
                            <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0">
                                <TextBlock Text="Personal Score (1–10)" FontWeight="SemiBold" FontSize="13" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumericUpDown Grid.Column="0"
                                                   Value="{Binding Score, Mode=TwoWay}"
                                                   Minimum="1"
                                                   Maximum="10"
                                                   FormatString="0"
                                                   HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Clear"
                                            Command="{Binding ClearScoreCommand}"
                                            Margin="8,0,0,0"
                                            Padding="10,6"
                                            CornerRadius="6"
                                            FontSize="12" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Total Episodes / Chapters & Current Progress Row -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,10,0">
                                <TextBlock Text="Total Episodes / Chapters" FontWeight="SemiBold" FontSize="13" />
                                <NumericUpDown Value="{Binding TotalProgress, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="100000"
                                               FormatString="0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0">
                                <TextBlock Text="{Binding CurrentProgressUnitLabel, StringFormat='{}{0} *'}"
                                           FontWeight="SemiBold"
                                           FontSize="13" />
                                <NumericUpDown Value="{Binding CurrentProgress, Mode=TwoWay}"
                                               Minimum="0"
                                               Maximum="100000"
                                               FormatString="0"
                                               HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>

                        <!-- Genres -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Genres (comma-separated)" FontWeight="SemiBold" FontSize="13" />
                            <TextBox Text="{Binding Genres, Mode=TwoWay}"
                                     PlaceholderText="e.g. Action, Fantasy, Sci-Fi..." />
                        </StackPanel>

                        <!-- Synopsis -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Synopsis / Notes" FontWeight="SemiBold" FontSize="13" />
                            <TextBox Text="{Binding Synopsis, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     Height="90"
                                     TextWrapping="Wrap"
                                     PlaceholderText="Enter plot synopsis or notes..." />
                        </StackPanel>

                        <!-- Timestamps / Metadata -->
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UpdatedAt, StringFormat='Last Updated: {0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="11"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                            <TextBlock Text="{Binding CreatedAt, StringFormat='Added: {0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="11"
                                       Foreground="{StaticResource AppTextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom Footer with Delete on Left and Actions on Right -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <!-- Left: Delete Button / Confirmation UI -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- Normal Delete button -->
                <Button Content="🗑 Delete Title"
                        Command="{Binding RequestDeleteCommand}"
                        IsVisible="{Binding !IsConfirmingDelete}"
                        Background="Transparent"
                        Foreground="#f87171"
                        BorderBrush="#ef4444"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,8" />

                <!-- Confirmation state -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsConfirmingDelete}">
                    <TextBlock Text="Are you sure you want to delete this title?"
                               VerticalAlignment="Center"
                               Foreground="#fca5a5"
                               FontWeight="SemiBold"
                               FontSize="12" />
                    <Button Content="Yes, Delete"
                            Command="{Binding ConfirmDeleteCommand}"
                            Background="#dc2626"
                            Foreground="White"
                            FontWeight="Bold"
                            CornerRadius="6"
                            Padding="12,6" />
                    <Button Content="Cancel"
                            Command="{Binding CancelDeleteCommand}"
                            CornerRadius="6"
                            Padding="12,6" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Cancel and Save Changes -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        CornerRadius="6"
                        Padding="16,8" />
                <Button Content="Save Changes"
                        Command="{Binding SaveCommand}"
                        Background="{StaticResource AppAccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        Padding="16,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
